    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
