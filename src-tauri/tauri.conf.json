{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Listenin",
  "version": "0.1.0",
  "identifier": "app.listenin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Local-first music player",
    "longDescription": "Listenin' browses artists and albums with your own Spotify account and plays the audio locally through your own yt-dlp binary. No hosted backend, no bundled content."
  }
}
